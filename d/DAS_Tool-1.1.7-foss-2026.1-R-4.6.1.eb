easyblock = 'Tarball'

name = 'DAS_Tool'
version = '1.1.7'
versionsuffix = '-R-%(rver)s'

homepage = 'https://github.com/cmks/DAS_Tool'
description = """DAS Tool is an automated method that integrates the results of a flexible number of binning
 algorithms to calculate an optimized, non-redundant set of bins from a single assembly."""

toolchain = {'name': 'foss', 'version': '2026.1'}

source_urls = ['https://github.com/cmks/DAS_Tool/archive/refs/tags']
sources = ['%(version)s.tar.gz']
#checksums = ['0cc41d7d12a1cdf24c7588148b8525e837347def49dd98b97a631a8e9cb08492']

# R now points at the source-built, real-dependency-chain R-4.6.1-foss-2026.1-MPI
# (the container-based r/R-4.6.1.eb is toolchain = SYSTEM and does not fit a
# foss-2026.1 dependency chain) -- see r/R-4.6.1-foss-2026.1-MPI.eb. That module
# is not yet built on this cluster, so this dependency is currently BLOCKING.
# Ruby 3.0.1 is already ported locally (r/Ruby-3.0.1-GCC-15.2.0.eb).
# pullseq, prodigal, BLAST and DIAMOND do not yet exist for this toolchain
# generation anywhere (checked upstream clone + this cluster) -- versions kept
# unchanged, all BLOCKING. See report for details of each.
dependencies = [
    ('R', '4.6.1', '-MPI', ('foss', '2026.1')),
    ('Ruby', '3.0.1', '', ('GCC', '15.2.0')),
    ('pullseq', '1.0.2','',SYSTEM),
    ('prodigal', '2.6.3'),
    ('BLAST', '2.16.0'),
    ('DIAMOND','2.1.9'),
]


postinstallcmds = [
    "cd %(installdir)s; unzip db.zip",
    "chmod a+x %(installdir)s/DAS_Tool",
]

sanity_check_paths = {
    'files': ['DAS_Tool','arc.all.faa'],
    'dirs': ['src'],
}

modextrapaths = {
    'PATH': '',
    'R_LIBS': ''
}

moduleclass = 'bio'
