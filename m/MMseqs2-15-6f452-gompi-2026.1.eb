easyblock = 'CMakeMake'

name = 'MMseqs2'
version = '15-6f452'

homepage = 'https://mmseqs.com'
description = "MMseqs2: ultra fast and sensitive search and clustering suite"

toolchain = {'name': 'gompi', 'version': '2026.1'}

source_urls = ['https://github.com/soedinglab/MMseqs2/archive/']
sources = ['%(version)s.tar.gz']
checksums = ['7115ac5a7e2a49229466806aaa760d00204bb08c870e3c231b00e525c77531dc']

# old SYSTEM CMake 3.27.7 pin was a 2023a-generation artifact; upstream's own
# MMseqs2 easyconfigs (2024a through 2025b) all use a version-pinned,
# non-SYSTEM CMake instead, so follow that convention here and point at the
# already-built CMake/4.2.1-GCCcore-15.2.0
builddependencies = [('CMake', '4.2.1', '', ('GCCcore', '15.2.0'))]

dependencies = [('bzip2', '1.0.8','',('GCCcore','15.2.0'))]

separate_build_dir = True

configopts = '-DCMAKE_BUILD_TYPE=RELEASE'

sanity_check_paths = {
    'files': ['bin/mmseqs'],
    'dirs': [],
}

moduleclass = 'bio'

