name = 'R'
version = '4.6.1'

homepage = 'https://www.r-project.org/'
description = """R is a free software environment for statistical computing
 and graphics."""

toolchain = {'name': 'foss', 'version': '2026.1'}

# The "one R with everything" build: full tidyverse (matching rocker/geospatial's
# own package set), the geospatial stack (sf/terra via native GDAL/GEOS/PROJ),
# and Rmpi/snow/doMPI cluster-parallel support -- all in a single native module,
# replacing both the earlier -MPI-only variant and the short-lived gfbf (no-MPI)
# variant. Toolchain is foss rather than gfbf specifically because GDAL's only
# upstream easyconfig for this generation (GDAL-3.13.0-foss-2026.1.eb) needs
# netCDF, which is foss/gompi-only here -- since that forces foss anyway,
# Rmpi/snow/snowfall/doMPI are included too rather than left out for no reason.
source_urls = ['https://cloud.r-project.org/src/base/R-%(version_major)s']
sources = [SOURCE_TAR_GZ]
checksums = ['4da6e61d2c0aac5f14a2e7e432cb5fcc269efe83da4293050ba7f03dff4e2cf4']

builddependencies = [
    ('pkgconf', '2.5.1'),
    ('Autotools', '20250626'),
    ('CMake', '4.2.1'),
]
dependencies = [
    ('X11', '20260518'),
    ('OpenGL', '2026.05'),
    ('cairo', '1.18.4'),
    ('libreadline', '8.3'),
    ('ncurses', '6.6'),
    ('bzip2', '1.0.8'),
    ('XZ', '5.8.2'),
    ('zlib', '2.3.2'),
    ('SQLite', '3.51.1'),
    ('PCRE2', '10.47'),
    ('libpng', '1.6.56'),
    ('libjpeg-turbo', '3.1.4.1'),
    ('libwebp', '1.6.0'),
    ('LibTIFF', '4.7.1'),
    ('Java', '21', '', SYSTEM),
    ('libgit2', '1.9.4'),
    ('OpenSSL', '3', '', SYSTEM),
    ('cURL', '8.17.0'),
    ('Tk', '9.0.3'),
    ('HarfBuzz', '14.2.0'),
    ('FriBidi', '1.0.16'),
    # Geospatial stack, for sf/terra below. GDAL is only available upstream
    # for this generation on foss (needs netCDF); GEOS/PROJ/libgeotiff/UDUNITS
    # all exist upstream regardless of toolchain choice.
    ('GDAL', '3.13.0'),
    ('GEOS', '3.14.1'),
    ('PROJ', '9.8.1'),
    ('libgeotiff', '1.7.4'),
    ('UDUNITS', '2.2.28'),
]

# Some R extensions (mclust, quantreg, waveslim for example) require the math library (-lm) to avoid undefined symbols.
# Adding it to FLIBS makes sure it is present when needed.
preconfigopts = 'export FLIBS="$FLIBS -lm" && '

configopts = "--with-pic --enable-threads --enable-R-shlib"
# some recommended packages may fail in a parallel build (e.g. Matrix), and
# we're installing them anyway below
configopts += " --with-recommended-packages=no"

exts_default_options = {
    'source_urls': [
        'https://cran.r-project.org/src/contrib/Archive/%(name)s',
        'https://cran.r-project.org/src/contrib/',
        'https://cran.freestatistics.org/src/contrib',
    ],
    'source_tmpl': '%(name)s_%(version)s.tar.gz',
}

