name = 'binutils'
version = '2.45'

homepage = 'https://directory.fsf.org/project/binutils/'

description = "binutils: GNU binary utilities"

toolchain = SYSTEM

source_urls = [GNU_SOURCE]
sources = [SOURCE_TAR_GZ]
checksums = ['8a3eb4b10e7053312790f21ee1a38f7e2bbd6f4096abb590d3429e5119592d96']

builddependencies = [
    ('flex', '2.6.4'),
    ('Bison', '3.8.2'),
    # zlib required, but being linked in statically, so not a runtime dep
    ('zlib', '1.3.1'),
]

# Bypass the dedicated EB_binutils easyblock (easybuild.easyblocks.binutils):
# its __init__ hardcodes `self.use_gold = get_cpu_family() != RISCV`, and its
# sanity_check_step() builds its OWN custom_paths from that - ignoring this
# easyconfig's sanity_check_paths entirely - so on any non-RISC-V build it
# always expects ld.gold to exist. Confirmed by hand: a real binutils 2.45
# build produces no ld.gold at all (gold has been dropped upstream as of
# this version), so EB_binutils can never pass sanity checking here no
# matter what this easyconfig says. Falling back to the generic
# ConfigureMake easyblock and replicating the configure flags EB_binutils
# would otherwise set for a SYSTEM-toolchain bootstrap build (sysroot,
# static+shared libs, ld as default with gold disabled, static system zlib).
easyblock = 'ConfigureMake'

configopts = '--with-sysroot=/ --enable-shared --enable-static '
configopts += '--enable-plugins --enable-ld=default --disable-gold '
configopts += '--with-system-zlib'

# avoid build failure when makeinfo command is not available
# see https://sourceware.org/bugzilla/show_bug.cgi?id=15345
buildopts = 'MAKEINFO=true'
installopts = buildopts

sanity_check_paths = {
    'files': ['bin/%s' % x for x in
              ['addr2line', 'ar', 'as', 'c++filt', 'elfedit', 'gprof', 'ld', 'ld.bfd',
               'nm', 'objcopy', 'objdump', 'ranlib', 'readelf', 'size', 'strings', 'strip']],
    'dirs': ['include', 'lib'],
}

moduleclass = 'tools'
